{
  "name": "knowledge-studio",
  "version": "2.0.0",
  "description": "Admin dashboard uploads & indexes files -> user chatbot answers ONLY from retrieved chunks (grounded RAG) -> confirmed answer can be exported as a real PDF / Word / PowerPoint / TXT file (AI is used only for drafting the export, never for the factual answer).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js",
    "migrate": "node scripts/migrate.js",
    "db:migrate": "node scripts/db/migrate_schema.js",
    "db:test": "node scripts/db-test.js",
    "db:migrate-data": "node scripts/migrate-kb-to-postgres.js",
    "test:embeddings": "node scripts/test_embeddings.js",
    "test:pdf-format": "node scripts/test_pdf_formatting.js",
    "embeddings:reindex": "node scripts/reindex_embeddings.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@napi-rs/canvas": "^1.0.8",
    "@xenova/transformers": "^2.17.2",
    "adm-zip": "^0.5.10",
    "docx": "^9.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "form-data": "^4.0.6",
    "js-yaml": "^5.4.1",
    "mammoth": "^1.7.2",
    "marked": "^18.0.11",
    "multer": "^1.4.5-lts.1",
    "node-html-parser": "^9.0.2",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.3.289",
    "pdfkit": "^0.15.0",
    "pg": "^8.23.0",
    "pptxgenjs": "^3.12.0",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  }
}
