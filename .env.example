LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=password@123

USER_ACCESS_CODE=user123

EXPOSE_CHUNK_TEXT_TO_USERS=true

# DATABASE CONFIGURATION
PGHOST=localhost
PGPORT=5432
PGDATABASE=knowledge_studio
PGUSER=postgres
PGPASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
# Optional only when PG* settings are absent. Do not use Docker hostnames or port 5440.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/knowledge_studio

# PGADMIN CONFIGURATION
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# EMBEDDINGS CONFIGURATION (LOCAL — no API key required)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# STORAGE CONFIGURATION
OBJECT_STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# SCALABILITY & CONCURRENCY CONFIGURATION
MAX_CONCURRENT_CHAT_REQUESTS=10
MAX_CONCURRENT_EMBEDDINGS=2
MAX_CONCURRENT_DOCUMENT_JOBS=2
MAX_CONCURRENT_LLM_REQUESTS=10
MAX_UPLOAD_SIZE_MB=50

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
EMBEDDING_BATCH_SIZE=25
EMBEDDING_MAX_RETRIES=3

CHAT_REQUEST_TIMEOUT_MS=30000
DOCUMENT_JOB_TIMEOUT_MS=300000
CHAT_RATE_LIMIT_PER_MINUTE=30

# OCR CONFIGURATION (AUTOMATIC SCANNED PDF FALLBACK)
OCR_ENABLED=true
OCR_PROVIDER=tesseract
OCR_MIN_TEXT_CHARS=50
OCR_LANG=eng
OCR_PAGE_BATCH_SIZE=5
OCR_MAX_PAGES=500
